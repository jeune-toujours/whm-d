{
  "compilerOptions": {
    "checkJs": false,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": true,
    "paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] },
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*", "*.svelte", "vite.config.js"]
}
